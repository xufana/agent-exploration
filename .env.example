# Keys are read by LiteLLM inside tau2; set the one for the provider you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LiteLLM model name for the agent under test (e.g. gpt-4.1-mini, anthropic/<model-id>).
AGENT_LLM=gpt-4.1-mini

# Own model behind an OpenAI-compatible API (vLLM, Ollama, proxy):
#   AGENT_LLM=openai/<model name as the server reports it>
#   AGENT_API_BASE=http://localhost:8000/v1
#   AGENT_API_KEY=<key, if the server checks one>
AGENT_API_BASE=
AGENT_API_KEY=

# Log level of the testbed and tau2 (DEBUG shows every LLM call and tool response).
STAND_LOG_LEVEL=WARNING
